# AgentGuard Environment Configuration
# Copy to .env for local runtime settings

# Application
AGENTGUARD_ENV=development
AGENTGUARD_DEBUG=false
AGENTGUARD_APP_NAME="AgentGuard - Policy Firewall & Escrow"
AGENTGUARD_API_PREFIX=/api/v1
AGENTGUARD_HOST=127.0.0.1
AGENTGUARD_PORT=8000
AGENTGUARD_LOG_LEVEL=INFO

# Database (SQLite with WAL mode)
AGENTGUARD_DATABASE_URL="sqlite:///./data/agentguard.db"

# PayPal Adapter (Isolated)
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
